# dev環境（テスト用コミュニティ）の .env 例。
# 使い方: このファイルを env/.env.dev にコピーして値を埋め、
#         実行時に APP_ENV=dev を渡すと env_loader がこちらを読む。
#
# 重要: prod と「同じアプリ」を dev コミュニティにも導入した前提なので、
#       認証情報（CLIENT_ID/SECRET/TOKEN_URL/API_ADDRESS）は prod と同一でよい。
#       違うのは下の「巡回コミュニティ」と、実投稿させる MIXI2_DRY_RUN。
#       状態は Firestore に COMMUNITY_ID 単位で分かれて保存されるため、
#       dev の COMMUNITY_ID にするだけで prod のカーソル/メンバーを汚さない。

# ===== mixi2 Application API（認証は prod と同じ値を入れる） =====
CLIENT_ID=XXXXXXXXXXXXXXXX
CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXX
TOKEN_URL=https://example.mixi.social/oauth/token
API_ADDRESS=api.mixi.social:443

# ===== ここが dev 固有 =====
# dev用テストコミュニティのID（prod とは別のコミュニティ）
COMMUNITY_ID=XXXXXXXX_DEV
# bot自身 / レポートDM送信先（prod と同じでよい。dev専用にしてもよい）
BOT_USER_ID=XXXXXXXX
ADMIN_USER_ID=XXXXXXXX

# 褒めスタンプID（dev コミュニティ固有スタンプを使うなら別ID）
PRAISE_STAMP_ID=XXXXXXXX

# dev コミュニティなので実際に投稿して挙動確認する（本番同様 0）
# 書き込みを止めてログだけ見たいときは 1 にする
MIXI2_DRY_RUN=0
